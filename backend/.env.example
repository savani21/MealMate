# Production and local database/auth configuration
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Email delivery (Gmail App Password or another SMTP provider)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_FROM=MealMate <yourgmail@gmail.com>

# Add your OpenAI API key here for AI recipe photo generation.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Meal plan AI (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_MS=75000
# Optional: increase for longer plans (maximum 14000)
OPENROUTER_MAX_TOKENS=9000

# Optional translation model override. Defaults to OPENROUTER_MODEL.
OPENROUTER_TRANSLATION_MODEL=openrouter/free
OPENROUTER_TRANSLATION_TIMEOUT_MS=30000

# Optional USDA FoodData Central API key for ingredient nutrition lookup
# Request a free key at https://fdc.nal.usda.gov/api-key-signup/
USDA_FDC_API_KEY=your_usda_fdc_api_key_here
