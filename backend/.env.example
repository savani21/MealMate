# Add your OpenAI API key here for AI recipe photo generation.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare


# Meal plan AI (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_MS=75000
# Optional: increase for longer plans (maximum 14000)
OPENROUTER_MAX_TOKENS=9000

# Optional USDA FoodData Central API key for ingredient nutrition lookup
# Request a free key at https://fdc.nal.usda.gov/api-key-signup.html
USDA_FDC_API_KEY=your_usda_fdc_api_key_here
