# Gmail account used to send MealMate password reset emails
GMAIL_USER=your-email@gmail.com
# Use a Google App Password (16 characters), NOT your normal Gmail password
GMAIL_APP_PASSWORD=your-16-character-app-password

# Frontend origin used to build password reset links
FRONTEND_URL=http://localhost:5173

# Google OAuth Web Client ID (must match the frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id
